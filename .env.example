# APEX — Environment Variables
# Copy this file to .env and fill in your keys.

# LLM Provider (Required)
# Get your free key at: https://openrouter.ai/keys
# One key gives access to DeepSeek, Kimi, and 200+ models.
OPENROUTER_API_KEY=sk-or-v1-your-key

# Web Search (Optional — DuckDuckGo fallback works without key)
# Get free key at: https://app.tavily.com (1000 searches/month free)
TAVILY_API_KEY=tvly-your-key

# Fish Audio TTS (Optional — browser fallback works without key)
# Get free key at: https://fish.audio
# Uses "BLACK AMERICAN DUDE" voice — deep, confident, American male
FISH_AUDIO_API_KEY=your-fish-key

# News APIs (optional — free RSS fallback works without these)
NEWSAPI_KEY=your-newsapi-key
GNEWS_KEY=your-gnews-key

# Server
PORT=3001