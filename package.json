{
  "name": "apex",
  "version": "0.2.0",
  "private": true,
  "description": "APEX — A Jarvis-style personal assistant (Next.js)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "service:start": "scripts/apex-service.sh start",
    "service:stop": "scripts/apex-service.sh stop",
    "service:restart": "scripts/apex-service.sh restart",
    "service:status": "scripts/apex-service.sh status",
    "service:logs": "scripts/apex-service.sh logs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "next": "^15.1.7",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.7",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sql.js": "^1.4.11",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3"
  }
}